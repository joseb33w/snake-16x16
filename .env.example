# Supabase project URL used by the browser client.
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable/anon key used by the browser client.
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Gogi-provided table prefix; the app reads <prefix>_snake_runs.
VITE_SUPABASE_TABLE_PREFIX=usr_example
